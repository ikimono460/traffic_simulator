<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="../network/aomori.net.xml"/>
        <route-files value="../demand/aomori.rou.xml,../demand/probe_vehicle.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>
    <processing>
        <time-to-teleport value="300"/> <!-- デッドロック回避のためのテレポート(5分)を有効化 -->
        <lateral-resolution value="0.3"/> <!-- サブレーンモデルの解像度を細分化 -->
    </processing>
    <routing>
        <device.rerouting.probability value="0.8"/> <!-- 80%の車両が渋滞状況に応じた自動迂回(ナビ)を行う -->
        <device.rerouting.period value="60"/> <!-- 60秒ごとに迂回ルートを再計算 -->
        <device.rerouting.adaptation-interval value="10"/> <!-- 直近10秒間の平均速度・混雑状況を集計 -->
    </routing>
    <output>
        <summary-output value="../output/summary.xml"/>
        <tripinfo-output value="../output/tripinfo.xml"/>
    </output>
</configuration>
